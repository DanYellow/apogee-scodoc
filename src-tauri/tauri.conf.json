{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "apogee-scodoc",
  "version": "0.1.0",
  "identifier": "com.danielojean-louis.apogee-scodoc",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../src/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Export Scodoc pour macro Apogée",
        "width": 800,
        "height": 750,
        "label": "main",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
